chat_server_deliver", "callee": "notification", "is_member_call": true, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L138"}, {"caller_nid": "cf_fakechat_server_deliver", "callee": "toISOString", "is_member_call": true, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L143"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "upgrade", "is_member_call": true, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L157"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "startsWith", "is_member_call": true, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L161"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "slice", "is_member_call": true, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L162"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "includes", "is_member_call": true, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L163"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "includes", "is_member_call": true, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L163"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "readFileSync", "is_member_call": false, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L165"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "join", "is_member_call": false, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L165"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "toLowerCase", "is_member_call": true, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L166"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "extname", "is_member_call": false, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L166"}, {"caller_nid": "cf_fakechat_server_fetch", "callee": "(async () => {\n        const form = await req.formData()\n        const id = String(form.get('id') ?? '')\n        const text = String(form.get('text') ?? '')\n        const f = form.get('file')\n        if (!id) return new Response('missing id', { status: 400 })\n        let file: { path: string; name: string } | undefined\n        if (f instanceof File && f.size > 0) {\n          mkdirSync(INBOX_DIR, { recursive: true })\n          const ext = extname(f.name).toLowerCase() || '.bin'\n          const path = join(INBOX_DIR, `${Date.now()}${ext}`)\n          writeFileSync(path, Buffer.from(await f.arrayBuffer()))\n          file = { path, name: f.name }\n        }\n        deliver(id, text, file)\n        return new Response(null, { status: 204 })\n      })", "is_member_call": false, "source_file": "/Users/debashispaul/GIT/claudifying/plugins/examples/cf-fakechat/server.ts", "source_location": "L174"}]}